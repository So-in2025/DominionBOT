# =============================================================================
# DOMINION BOT WHATSAPP - CONFIGURACIÓN DE ENTORNO (TEMPLATE DE EJEMPLO)
# Copia este archivo a .env.local (desarrollo) o .env (producción) y completa los valores.
# NUNCA comitees archivos con contraseñas o claves reales al repositorio.
# =============================================================================

# Entorno y Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO

# Proveedor de WhatsApp ('baileys' | 'cloud')
# NOTA: En la fase actual, 'baileys' es el único proveedor implementado.
# Configurar 'cloud' lanzará un error explícito hasta que sea implementado.
WA_PROVIDER=baileys

# Seguridad y Autenticación JWT (OBLIGATORIO cambiar por una clave secreta robusta de 64+ caracteres en producción)
JWT_SECRET=tu_clave_secreta_jwt_aleatoria_y_segura_de_produccion_aqui

# Credenciales de Super Administrador (Acceso Maestro)
MASTER_ADMIN_USER=master
MASTER_ADMIN_PASSWORD=tu_contrasena_maestra_segura_aqui

# Base de Datos MongoDB (Mongoose)
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.ejemplo.mongodb.net/dominion?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario_placeholder:password_placeholder@cluster0.ejemplo.mongodb.net/dominion_db?retryWrites=true&w=majority

# Cache y Colas de Campañas (Redis / Upstash / Redis local)
REDIS_URL=redis://127.0.0.1:6379

# Inteligencia Artificial (Google Gemini API Key para motor de respuestas y TTS de bienvenida)
# Puede configurarse a nivel servidor o individualmente por cliente en su panel de configuración
API_KEY=tu_gemini_api_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# URLs del Frontend / Backend (Opcional, en blanco utiliza el mismo origen del navegador)
BACKEND_URL=
VITE_BACKEND_URL=
