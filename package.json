{
  "name": "dominion-bot-saas",
  "version": "3.0.0",
  "description": "La herramienta de IA para no perder ventas en WhatsApp. Responde, califica y te notifica 24/7.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run server:dev",
    "server:dev": "tsx src/server.ts",
    "client:dev": "npx vite",
    "build": "npm run build:full",
    "build:full": "npm run build:client && npm run build:server",
    "build:client": "npx vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@google/genai": "^1.34.0",
    "@hapi/boom": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "@whiskeysockets/baileys": "^6.7.2",
    "autoprefixer": "^10.4.19",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.8",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "https-proxy-agent": "^7.0.4",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.1",
    "pino": "^9.2.0",
    "postcss": "^8.4.38",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tailwindcss": "^3.4.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "uuid": "^9.0.1",
    "vite": "^5.2.0"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
